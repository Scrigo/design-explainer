new file mode 100644
index 0000000..4eb8b13
--- /dev/null
+++ b/bookshop/invoicing/service.py
@@ -0,0 +1,16 @@
+from sqlalchemy.orm import Session
+
+from bookshop.invoicing.models import Invoice
+from bookshop.orders.models import Order
+
+
+def create_invoice(session: Session, order: Order) -> Invoice:
+    invoice = Invoice(
+        number=f"INV-{order.id:08d}",
+        order_id=order.id,
+        customer_email=order.customer_email,
+        amount=order.total,
+    )
+    session.add(invoice)
+    session.commit()
+    return invoice
